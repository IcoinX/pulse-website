{
  "headers": [
    {
      "source": "/api/feeds/:id",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/feed", "destination": "/api/feeds" }
  ],
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 0 * * *"
    }
  ]
}
